PORT=3001
DATABASE_URL=postgres://node_monitor:node_monitor@localhost:5432/node_monitor
CLICKHOUSE_URL=http://localhost:8123
REDIS_URL=redis://localhost:6379
ACCESS_TOKEN_SECRET=dev-access-secret-change-me
REFRESH_TOKEN_SECRET=dev-refresh-secret-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Optional — email alerts are skipped with a log warning if SMTP_HOST is unset
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_FROM=alerts@node-monitor.local
