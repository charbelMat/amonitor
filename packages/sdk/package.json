{
  "name": "amonitor",
  "version": "0.1.1",
  "description": "Error tracking and performance tracing client for Node.js — reports uncaught exceptions, breadcrumbs and request traces to an amonitor instance",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "author": "Charbel Mattar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/charbelMat/amonitor.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/charbelMat/amonitor/tree/main/packages/sdk#readme",
  "bugs": {
    "url": "https://github.com/charbelMat/amonitor/issues"
  },
  "keywords": [
    "monitoring",
    "error-tracking",
    "error-reporting",
    "exceptions",
    "tracing",
    "apm",
    "observability",
    "nodejs"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=16"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "test": "jest",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testRegex": ".*\\.spec\\.ts$"
  }
}
